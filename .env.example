# GEMINI_API_KEY: Required for Gemini AI API calls (AI Tutor, Interactive Notes, Live Voice).
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for live EduTube searches.
# Users configure this via the Secrets panel in the AI Studio UI.
YOUTUBE_API_KEY=MY_YOUTUBE_API_KEY
